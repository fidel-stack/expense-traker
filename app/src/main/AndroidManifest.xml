<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- New incoming SMS only: no inbox reading, sending, contacts or phone-state access. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".ExpenseTrackerApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SMS_RECEIVED is a protected system broadcast; the BROADCAST_SMS permission is the
            sender-side permission held by the telephony stack, so no ordinary app can invoke
            this receiver.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.intent.action.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
